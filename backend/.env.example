# LeadMe Backend Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadme
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production

# Routing provider: "google", "mapbox", "here", "mock" (or leave empty for auto-detect)
ROUTING_PROVIDER=

# Routing API keys (set the one matching your routing provider)
GOOGLE_ROUTES_API_KEY=your-google-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token
HERE_API_KEY=your-here-api-key

# SMS provider: "twilio", "msg91", "console" (or leave empty for auto-detect)
SMS_PROVIDER=

# Twilio (if using Twilio for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 (if using MSG91 for SMS — popular in India)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# XRP (testnet by default)
XRPL_NETWORK_URL=wss://s.altnet.rippletest.net:51233

# App
DEBUG=true
